{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.quantisnow/sec-edgar-mcp",
  "title": "Quantisnow SEC EDGAR",
  "description": "SEC EDGAR full-text search, Form 4 insider trades, 13F holdings, 8-K events, XBRL financials.",
  "websiteUrl": "https://www.quantisnow.com/sec-api/mcp",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/quantisnow/sec-edgar-mcp/main/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/quantisnow/sec-edgar-mcp",
    "source": "github"
  },
  "version": "1.0.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.quantisnow.com/api/v1/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "quantisnow",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
